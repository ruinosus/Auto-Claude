    "title": "How ROI is Calculated",
    "button": "How is ROI calculated?",
    "intro": "Auto-Claude calculates ROI by measuring the value generated across 4 dimensions, compared to the AI cost.",
    "formula": {
      "title": "ROI Formula",
      "description": "The core formula that drives all ROI calculations",
      "equation": "ROI = (Total Value - AI Cost) / AI Cost × 100%",
