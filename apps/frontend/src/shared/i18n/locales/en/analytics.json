        "examples": ["Security vulnerabilities found", "Bugs caught in QA", "Features NOT built (cost avoidance)", "Rework avoided"]
      },
      "knowledge": {
        "name": "Knowledge",
        "desc": "Learning value from exploration and documentation",
        "calculation": "Time saved × Hourly Rate × 0.4-0.5",
