        "name": "Execution",
        "desc": "Direct work value from code generated and dev hours saved",
        "calculation": "(Lines of code ÷ 20) × Hourly Rate × Quality Multiplier",
        "examples": ["Lines of code generated", "Dev hours saved", "Files modified", "Tests written"]
      },
      "decision": {
        "name": "Decision",
        "desc": "Strategic value from prioritization and architecture choices",
